# ==============================================================================
# 🌿 EcoTrack Waste Management System - Environment Variables Template (.env.example)
# Copy this file to .env and configure your secret credentials
# ==============================================================================

# Server Settings
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT=10mb

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=replace_with_secure_admin_api_key

# Database
DB_TYPE=json
MONGO_URI=mongodb://localhost:27017/ecotrack

# Municipal Defaults
DEFAULT_SECTOR="Sector 7, River North"

# Optional Cloud Integrations
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
